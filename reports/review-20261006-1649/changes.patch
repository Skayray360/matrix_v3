+])
+def test_fabrication_without_sources_is_an_error_not_a_published_answer(sql, draft):
+    db, _, _ = sql
+    ctx = make_context(categories=frozenset({"prestaciones"}), wildcard=False)
+    retriever = MagicMock()
+    retriever.retrieve.return_value = RetrievalResult()
