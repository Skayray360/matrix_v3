+def format_evidence_block(
+    evidences: tuple[Evidence, ...], *, max_chars_each: int | None = None,
+    aliases: dict[str, str] | None = None,
+) -> str:
+    """Serializa unidades completas; el agente decide cuales caben en el perfil.
