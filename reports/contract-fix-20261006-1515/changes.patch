+        return None, "fecha de ingreso no selecciona una regla unica"
+    quote = selected[0]
+    if re.search(r"antes de cumplir[^.]*jubil", quote) and not case.before_retirement:
+        return None, "falta supuesto de retiro anterior a jubilacion"
