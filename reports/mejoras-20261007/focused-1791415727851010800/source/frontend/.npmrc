# Creado por Aldo Garcia.
# ---------------------------------------------------------------------------
# Endurecimiento de la instalacion de dependencias de Matrix RH.
#
# El gestor oficial es npm 11.9.0, fijado con SHA-512 en `packageManager`.
# Corepack verifica ese pin; estas reglas siguen aplicandose a npm.
#
# ignore-scripts=true es el control central: los gusanos del ecosistema npm se
# propagan ejecutando `preinstall`/`install`/`postinstall` en el equipo que
# instala. Con esta linea, aunque un paquete comprometido entre al arbol, su
# codigo NO se ejecuta durante la instalacion. Ademas, cada instalador la
# repite en la linea de comandos
# (`--ignore-scripts`) para que el control no dependa de este archivo editable.
#
# Es viable porque los binarios de la herramienta de build se distribuyen por
# optionalDependencies de la plataforma. El build forma parte de la validacion.
#
# Playwright SI necesita descargar navegadores; se hace de forma explicita y
# consciente con `corepack npm run e2e:install`, nunca al instalar dependencias.
# ---------------------------------------------------------------------------

ignore-scripts=true

# Instalacion reproducible: se respeta el lockfile y no se resuelven rangos.
save-exact=true

# Solo el registro oficial. Evita que un .npmrc heredado apunte a un espejo.
registry=https://registry.npmjs.org/
