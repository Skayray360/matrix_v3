# Creado por Aldo Garcia.
# Plantilla local reconstruida desde Settings. No contiene secretos reales.
# El instalador copia este archivo SOLO cuando no existe .env y genera una
# APP_SECRET_KEY estable. La actualizacion respalda .env y adapta ajustes
# operativos heredados; conserva credenciales, modelos y pins existentes.
# Para produccion configure OIDC interno, HTTPS, permisos y cuentas SQL propias.



# Aplicacion (desarrollo local)
APP_ENV=development
APP_NAME=Matrix RH
APP_BASE_URL=http://127.0.0.1:8000
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=
# Uvicorn solo confia en proxies IP/CIDR declarados; nunca '*' ni redes /0.
FORWARDED_ALLOW_IPS=127.0.0.1,::1

# Modelos instalados en Ollama; confirmar sus etiquetas con ollama list
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_FAST_MODEL=gemma4:latest
OLLAMA_DEEP_MODEL=gemma4:latest
OLLAMA_EMBEDDING_MODEL=embeddinggemma:latest
OLLAMA_EMBEDDING_DIMENSION=768
OLLAMA_TIMEOUT_SECONDS=600.0
OLLAMA_KEEP_ALIVE=15m
OLLAMA_FAST_NUM_CTX=8192
OLLAMA_DEEP_NUM_CTX=8192
OLLAMA_FAST_MAX_TOKENS=1536
OLLAMA_DEEP_MAX_TOKENS=3072
OLLAMA_EMBEDDING_CACHE_SIZE=256
# Legado compatible, sin efecto: los lotes de resumen se ejecutan secuencialmente.
OLLAMA_SUMMARY_PARALLEL_BATCHES=2

# Proveedores de inferencia. El modo local bloquea endpoints no autorizados
LLM_PROVIDER=ollama
LLM_DEEP_PROVIDER=ollama
LLM_EMBEDDING_PROVIDER=ollama
LLM_LOCAL_ONLY=true
LLM_LOCAL_HOSTS=127.0.0.1,localhost,::1
LLM_API_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_VERTEX_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_GENERAL_TEMPERATURE=0.25
LLM_SUMMARY_TEMPERATURE=0.08
LLM_RETRY_TEMPERATURE=0.03
LLM_TOP_P=0.9
# auto pide respuesta final sin thinking a Ollama; otros adapters conservan su valor nativo.
# enabled habilita thinking expresamente; default conserva el valor nativo de Ollama.
LLM_FAST_THINKING=auto
LLM_DEEP_THINKING=auto
LLM_STRUCTURED_THINKING=auto
# Solo regenera una salida terminada por length o solo thinking; nunca un timeout.
LLM_COMPLETION_RETRIES=1
# Legado compatible, sin efecto: un POST ambiguo nunca se reintenta automaticamente.
LLM_MAX_TRANSIENT_RETRIES=0
# Presupuesto global compartido por RAG, plan, memoria y generacion.
LLM_REQUEST_DEADLINE_SECONDS=600
# Limite por intento: ambos perfiles usan Gemma; no hay fallback a otro modelo.
LLM_FAST_TIMEOUT_SECONDS=180
LLM_DEEP_TIMEOUT_SECONDS=180
# Permite explicaciones conceptuales; no inventa politicas o datos privados.
ANSWER_ALLOW_GENERAL_KNOWLEDGE=true
# cited valida referencias autorizadas y cifras; extractive exige texto literal.
ANSWER_EVIDENCE_MODE=cited
LLM_PLANNER_MAX_TOKENS=600
LLM_PLANNER_TEMPERATURE=0.0
LLM_MEMORY_MAX_TOKENS=200
LLM_EMBEDDING_REVISION=unverified
# El instalador fija los digests faltantes desde el runtime local. Staging y
# production exigen fast/deep SHA-256; cambiar pesos exige evaluar y actualizar
# el pin deliberadamente. Un runtime compatible debe exponer digest en /models.
LLM_FAST_DIGEST=
LLM_DEEP_DIGEST=
LLM_EMBEDDING_DIGEST=
LLM_QUERY_TEMPLATE=task: search result | query: {text}
LLM_DOCUMENT_TEMPLATE=title: {title} | text: {text}
LLM_SYSTEM_PREFIX=

# Admision, cola y limites de extraccion
CHAT_MAX_INFLIGHT=4
INFERENCE_MAX_INFLIGHT=2
CHAT_QUEUE_MAX_SIZE=50
CHAT_QUEUE_TIMEOUT_SECONDS=180
CHAT_BUSY_THRESHOLD_PERCENT=90
UPLOAD_MAX_INFLIGHT=1
UPLOAD_MAX_TOTAL_BYTES=134217728
UPLOAD_MAX_DOCUMENTS_PER_USER=50
UPLOAD_BODY_MAX_BYTES=30000000
EXTRACTION_TIMEOUT_SECONDS=30
EXTRACTION_MEMORY_MB=512
EXTRACTION_MAX_CHARS=2000000

# RAG. Los cambios de embeddings/chunking requieren ingesta
RAG_VECTOR_STORE=qdrant
RAG_CHUNK_SIZE_TOKENS=900
RAG_CHUNK_OVERLAP_TOKENS=120
RAG_EMBEDDING_DIMENSION=768
RAG_TOP_K=6
RAG_FETCH_K=24
RAG_MIN_SIMILARITY=0.35
RAG_MMR_LAMBDA=0.65
RAG_SEARCH_STRATEGY=cosine_hnsw_metadata_filter_mmr
RAG_REINDEX_INTERVAL_HOURS=24
RAG_KNOWLEDGE_ROOT=./data/knowledge
RAG_COLLECTION_CORPORATE=matrix_rh_corporate
RAG_COLLECTION_PRIVATE=matrix_rh_private
RAG_SUMMARY_SCAN_MAX_CHUNKS=256
RAG_SUMMARY_MAX_CHUNKS=24

# Autenticacion local solo para desarrollo/pruebas
AUTH_PROVIDER=local_test
LOCAL_TEST_AUTH_ENABLED=true
LOCAL_TEST_SEED_USERS_ENABLED=true
LOCAL_TEST_SEED_PROFILE=matrix_demo
# Nuevo seed: el instalador genera un valor aleatorio y lo guarda en .env privado.
# Reinstalar conserva hashes existentes; este campo no reinicia contrasenas.
MATRIX_SEED_PASSWORD=
SESSION_COOKIE_NAME=matrixrh_session
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=30
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Entra: adapter opcional; no activar para el despliegue totalmente interno
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=
ENTRA_POST_LOGOUT_REDIRECT_URI=
ENTRA_ALLOWED_GROUPS=
ENTRA_ROLE_MAPPING_FILE=./config/authorization/entra-role-mapping.yaml

# OIDC interno: completar con los valores que proporcione TI
OIDC_ISSUER=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_ALLOWED_GROUPS=

# MySQL/WAMP de desarrollo; cambie DATABASE_URL para su instalacion
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/matrix_rh_131?charset=utf8mb4
DATABASE_POOL_SIZE=5
DATABASE_ECHO=false
# Opcional Windows local: si vacio, el preflight consulta @@datadir.
DATABASE_DATADIR_PATH=

# Declaracion documentada por TI; estos flags NO activan cifrado por si solos.
# Staging/production requieren los tres flags y un archivo de evidencia local.
# Windows tambien mide BitLocker en los volumenes locales de datos.
STORAGE_ENCRYPTION_ATTESTED=false
DATABASE_ENCRYPTION_ATTESTED=false
BACKUP_ENCRYPTION_ATTESTED=false
ENCRYPTION_ATTESTATION_REFERENCE=

# Fuentes SQL de solo lectura (inactivas por defecto en sources.yaml)
STRUCTURED_SOURCES_CONFIG=./config/data_sources/sources.yaml
STRUCTURED_QUERY_TIMEOUT_SECONDS=15
STRUCTURED_MAX_ROWS=200

# Qdrant embebido: un unico proceso; server para un servicio dedicado
QDRANT_MODE=embedded
QDRANT_PATH=./var/qdrant
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Politicas de categorias
AUTHORIZATION_POLICY_FILE=./config/authorization/categories.yaml

# Adjuntos privados
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_FILES_PER_REQUEST=5
UPLOAD_STORAGE_ROOT=./var/uploads
UPLOAD_ALLOWED_EXTENSIONS=.docx,.md,.pdf,.txt,.xlsx,.csv

# Limites de solicitudes
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=30

# Reconciliacion periodica
SCHEDULER_ENABLED=true
# Definir plazos con RH/Normatividad antes de activar. No hay plazos inventados.
RETENTION_ENABLED=false
RETENTION_CONVERSATION_DAYS=
RETENTION_OPERATION_DAYS=
RETENTION_AUDIT_DAYS=
RETENTION_BATCH_SIZE=100

# Instalacion local y propiedad de la base de datos
MATRIX_INSTALL_MODE=windows_local
MATRIX_USE_WAMP_MYSQL=true
MATRIX_EXTERNAL_CONNECTORS_REQUIRED=false
MATRIX_ADOPT_EXISTING_DATABASE=false
